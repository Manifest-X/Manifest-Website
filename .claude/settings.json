{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ui-guard.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ui-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash|Monitor|mcp__terminal__run_in_terminal|mcp__.*__manifest_(promote|publish|publish_files|rollback)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/promote-gate.mjs\" || exit 2",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
